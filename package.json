{
  "name": "graph-memory-pro",
  "version": "2.0.0",
  "description": "Neo4j Knowledge Graph Memory Engine for OpenClaw — GDS PageRank, community detection, vector index, Neovis 3D",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "index.ts",
    "src",
    "migrate",
    "setup-graph-memory-pro.sh",
    "openclaw.plugin.json",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "neo4j-driver": "^5.27.0",
    "opencode-ai": "^1.18.16"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "peerDependencies": {
    "openclaw": "*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.2"
    },
    "install": {
      "minHostVersion": ">=2026.4.2"
    }
  }
}
